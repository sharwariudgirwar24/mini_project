{
    "name": "sellsmart",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "dist": "cd frontend && npm run build && cd .. && xcopy frontend\\dist dist-frontend /E /I /Y /Q && electron-builder --win nsis"
    },
    "build": {
        "appId": "com.sellsmart.app",
        "productName": "SellSmart",
        "asar": false,
        "win": {
            "target": "nsis"
        },
        "extraResources": [
            {
                "from": "resources/sellsmart-ml.exe",
                "to": "sellsmart-ml.exe"
            }
        ],
        "files": [
            "main.js",
            "backend/**/*",
            "node_modules/**/*",
            "dist-frontend/**/*"
        ]
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csv-parser": "^3.2.0",
"dotenv":"^17.3.1",
"express":"^4.21.1",
        "framer-motion": "^12.38.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.1.1",
"mongoose":"^8.6.0",
"multer":"^1.4.18",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0",
        "recharts": "^3.8.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "uuid": "^14.0.0",
        "validator": "^13.15.35"
    },
    "devDependencies": {
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.2.1",
        "electron": "^41.1.1",
        "electron-builder": "^26.8.1",
        "vite": "^6.0.5"
    }
}
